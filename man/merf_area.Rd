vardir <- rep(0.04, D)
y_dir <- y_true + rnorm(D, 0, sqrt(vardir))

df <- data.frame(
  domain = paste0("area_", 1:D),
  y = y_dir,
  vardir = vardir,
  x1 = x1,
  x2 = x2
